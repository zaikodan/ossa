# Copie para .env e ajuste. NUNCA commite segredos reais (.env é gitignored).

NODE_ENV=development
PORT=4000

# Postgres (ver docker-compose.yml — porta 5433 p/ não colidir com outros).
DATABASE_URL=postgresql://ossa:ossa@localhost:5433/ossa?schema=public

# Redis (presença + pub/sub multi-instância).
REDIS_URL=redis://localhost:6379

# Segredo compartilhado com a PLATAFORMA que emite os JWTs dos usuários.
# O Ossa valida o access token e usa o `sub` como userId. Troque em produção.
JWT_ACCESS_SECRET=dev-shared-secret-change-me-min-16-chars

# Origem web permitida no CORS.
WEB_ORIGIN=http://localhost:3000
